# Generate a unique value with: openssl rand -hex 32
PC_CONTROL_TOKEN=replace-with-at-least-32-random-characters

# Safe defaults. Do not bind to 0.0.0.0; use a secure tunnel instead.
PC_CONTROL_HOST=127.0.0.1
PC_CONTROL_PORT=5000

# Optional: an iMessage-enabled phone number or Apple ID email. Only the
# temporary HTTPS URL is sent; the bearer token is intentionally omitted.
MUSE_IMESSAGE_RECIPIENT=
