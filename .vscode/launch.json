{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Muse PC Control",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PC_CONTROL_HOST": "127.0.0.1",
        "PC_CONTROL_PORT": "5000"
      },
      "justMyCode": true
    }
  ]
}
